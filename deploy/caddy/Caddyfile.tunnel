# The Mac deploy. Cloudflare terminates TLS, and cloudflared on the internal edge network is the
# only client, so Caddy serves plain HTTP there and publishes no port.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

:80 {
	import site.caddy
}
