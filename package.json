{
  "name": "nitrosamine-lims",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "db:up": "scripts/pg.sh up",
    "db:down": "scripts/pg.sh down",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:deploy": "tsc --noEmit -p deploy && vitest run --root deploy && node deploy/checks/compose-mounts.ts && pnpm --filter @lims/web exec vitest run src/bundle.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "kysely-codegen": "0.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
